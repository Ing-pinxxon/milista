# Conexion a Postgres.
#
# En Vercel no hace falta ponerla: al conectar la base (Storage → Connect Project)
# las variables las inyecta la plataforma, con el nombre que sea. La app las
# encuentra por su valor, no por su nombre.
#
# En local basta con esta, y DATABASE_URL_UNPOOLED con el mismo valor: Prisma la
# exige para las migraciones aunque en local no haya pooler.
DATABASE_URL="postgresql://usuario:clave@localhost:5432/milista?schema=public"
DATABASE_URL_UNPOOLED="postgresql://usuario:clave@localhost:5432/milista?schema=public"

# Clave unica para poder escribir (pegar listas, editar precios, cargar el catalogo).
# La lectura es publica; esto protege todo lo que modifica datos.
# Sin esta variable la app queda de solo lectura.
CLAVE_ESCRITURA="cambia-esto-por-algo-largo"

# URL publica de la app. Opcional.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
