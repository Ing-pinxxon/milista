# Postgres. En Railway lo inyecta el plugin de PostgreSQL automaticamente.
DATABASE_URL="postgresql://usuario:clave@localhost:5432/milista?schema=public"

# Clave unica para poder escribir (pegar listas, editar precios).
# La lectura es publica; esto protege todo lo que modifica datos.
CLAVE_ESCRITURA="cambia-esto-por-algo-largo"

# URL publica de la app, para el manifest de la PWA.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
